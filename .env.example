DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Produção (Render): o domínio *.onrender.com é liberado automaticamente
# pela variável RENDER_EXTERNAL_HOSTNAME, que o próprio Render define.
# Banco: sem DATABASE_URL, o projeto usa o SQLite local.
# Neon: copie a URL em Connect (sem "Connection pooling").
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
